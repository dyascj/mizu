{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://mizu-ui.com/schemas/registry.json",
	"title": "Mizu registry",
	"type": "object",
	"required": ["$schema", "name", "homepage", "items"],
	"properties": {
		"$schema": {
			"const": "https://shadcn-svelte.com/schema/registry.json"
		},
		"name": {
			"const": "mizu"
		},
		"homepage": {
			"type": "string",
			"pattern": "^https://"
		},
		"items": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "https://mizu-ui.com/schemas/registry-item.json"
			}
		}
	},
	"additionalProperties": false
}
