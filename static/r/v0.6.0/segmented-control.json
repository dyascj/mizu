      "content": "import Root from './segmented-control.svelte';\nimport Item from './segmented-control-item.svelte';\n\nexport {\n\tRoot,\n\tItem,\n\t//\n\tRoot as SegmentedControl,\n\tItem as SegmentedControlItem\n};\n"
