{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "message-actions",
  "type": "registry:ui",
  "title": "Message Actions",
  "description": "Copy, regenerate, and feedback beneath a reply.",
  "dependencies": [
    "@lucide/svelte@^1.39.0"
  ],
  "registryDependencies": [
    "https://mizu-ui.com/r/latest/utils.json"
  ],
  "files": [
    {
      "type": "registry:file",
      "target": "message-actions/index.ts",
      "content": "export { default as MessageActions } from './message-actions.svelte';\n"
    },
    {
      "type": "registry:file",
      "target": "message-actions/message-actions.svelte",
      "content": "<script lang=\"ts\">\n\timport Copy from '@lucide/svelte/icons/copy';\n\timport Check from '@lucide/svelte/icons/check';\n\timport RotateCcw from '@lucide/svelte/icons/rotate-ccw';\n\timport ThumbsUp from '@lucide/svelte/icons/thumbs-up';\n\timport ThumbsDown from '@lucide/svelte/icons/thumbs-down';\n\timport { cn } from '$lib/utils.js';\n\n\ttype Props = {\n\t\t/** The message text the copy button writes to the clipboard. */\n\t\ttext?: string;\n\t\tonRegenerate?: () => void;\n\t\t/** Reports the current vote, or null when the user clears it. */\n\t\tonFeedback?: (feedback: 'up' | 'down' | null) => void;\n\t\tclass?: string;\n\t};\n\n\tlet { text, onRegenerate, onFeedback, class: className }: Props = $props();\n\n\tlet copyStatus = $state<'idle' | 'copied' | 'error'>('idle');\n\tlet feedback = $state<'up' | 'down' | null>(null);\n\tlet resetTimer: ReturnType<typeof setTimeout> | undefined;\n\n\tfunction scheduleReset() {\n\t\tif (resetTimer) clearTimeout(resetTimer);\n\t\tresetTimer = setTimeout(() => (copyStatus = 'idle'), 1600);\n\t}\n\n\tasync function copy() {\n\t\tif (!text) return;\n\t\ttry {\n\t\t\tawait navigator.clipboard.writeText(text);\n\t\t\tcopyStatus = 'copied';\n\t\t} catch {\n\t\t\tcopyStatus = 'error';\n\t\t}\n\t\tscheduleReset();\n\t}\n\n\tfunction vote(dir: 'up' | 'down') {\n\t\tfeedback = feedback === dir ? null : dir;\n\t\tonFeedback?.(feedback);\n\t}\n\n\t$effect(() => () => {\n\t\tif (resetTimer) clearTimeout(resetTimer);\n\t});\n\n\tconst btn =\n\t\t'inline-flex size-7 items-center justify-center rounded-full text-muted-foreground outline-none transition-[background-color,color,scale] hover:bg-secondary hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring active:scale-[0.94]';\n</script>\n\n<div class={cn('flex items-center gap-0.5', className)}>\n\t{#if text !== undefined}\n\t\t<button\n\t\t\ttype=\"button\"\n\t\t\tclass={btn}\n\t\t\tonclick={copy}\n\t\t\taria-label={copyStatus === 'error'\n\t\t\t\t? 'Copy failed, try again'\n\t\t\t\t: copyStatus === 'copied'\n\t\t\t\t\t? 'Message copied'\n\t\t\t\t\t: 'Copy message'}\n\t\t>\n\t\t\t{#if copyStatus === 'copied'}\n\t\t\t\t<Check class=\"size-3.5 text-[color:var(--success)]\" />\n\t\t\t{:else}\n\t\t\t\t<Copy class={cn('size-3.5', copyStatus === 'error' && 'text-destructive')} />\n\t\t\t{/if}\n\t\t</button>\n\t\t<span class=\"sr-only\" aria-live=\"polite\">\n\t\t\t{copyStatus === 'copied' ? 'Message copied' : copyStatus === 'error' ? 'Copy failed' : ''}\n\t\t</span>\n\t{/if}\n\t{#if onRegenerate}\n\t\t<button type=\"button\" class={btn} onclick={onRegenerate} aria-label=\"Regenerate response\">\n\t\t\t<RotateCcw class=\"size-3.5\" />\n\t\t</button>\n\t{/if}\n\t<button\n\t\ttype=\"button\"\n\t\tclass={cn(btn, feedback === 'up' && 'bg-primary-muted text-primary')}\n\t\tonclick={() => vote('up')}\n\t\taria-label=\"Good response\"\n\t\taria-pressed={feedback === 'up'}\n\t>\n\t\t<ThumbsUp class=\"size-3.5\" />\n\t</button>\n\t<button\n\t\ttype=\"button\"\n\t\tclass={cn(btn, feedback === 'down' && 'bg-primary-muted text-primary')}\n\t\tonclick={() => vote('down')}\n\t\taria-label=\"Bad response\"\n\t\taria-pressed={feedback === 'down'}\n\t>\n\t\t<ThumbsDown class=\"size-3.5\" />\n\t</button>\n</div>\n"
    }
  ]
}
