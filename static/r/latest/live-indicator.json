{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "live-indicator",
  "type": "registry:ui",
  "title": "Live Indicator",
  "description": "Breathes while live and blinks hollow while reconnecting.",
  "dependencies": [
    "@lucide/svelte@^1.48.0"
  ],
  "registryDependencies": [
    "https://mizu-ui.com/r/latest/motion.json",
