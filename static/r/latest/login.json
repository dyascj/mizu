      "content": "<script lang=\"ts\">\n\timport { Button } from '$lib/components/ui/button';\n\timport { Input } from '$lib/components/ui/input';\n\timport { Label } from '$lib/components/ui/label';\n\timport { VoiceOrb } from '$lib/components/ui/voice-orb';\n\n\tlet email = $state('');\n\tlet password = $state('');\n\tlet notice = $state('');\n</script>\n\n<form\n\tonsubmit={(event) => {\n\t\tevent.preventDefault();\n\t\tnotice = 'Preview complete. No sign-in request was sent.';\n\t}}\n\tclass=\"bg-card mx-auto flex w-full max-w-sm flex-col items-center gap-6 rounded-3xl p-5 shadow-md sm:p-8\"\n>\n\t<div class=\"flex flex-col items-center gap-3 text-center\">\n\t\t<VoiceOrb state=\"idle\" size={44} />\n\t\t<div>\n\t\t\t<h2 class=\"text-lg font-semibold tracking-tight\">Welcome back</h2>\n\t\t\t<p class=\"text-muted-foreground mt-1 text-sm\">Sign in to your workspace.</p>\n\t\t</div>\n\t</div>\n\n\t<div class=\"flex w-full flex-col gap-4\">\n\t\t<div class=\"flex flex-col gap-1.5\">\n\t\t\t<Label for=\"login-email\">Email</Label>\n\t\t\t<Input\n\t\t\t\tid=\"login-email\"\n\t\t\t\ttype=\"email\"\n\t\t\t\tautocomplete=\"email\"\n\t\t\t\trequired\n\t\t\t\tplaceholder=\"you@example.com\"\n\t\t\t\tbind:value={email}\n\t\t\t/>\n\t\t</div>\n\t\t<div class=\"flex flex-col gap-1.5\">\n\t\t\t<div class=\"flex items-center justify-between\">\n\t\t\t\t<Label for=\"login-password\">Password</Label>\n\t\t\t\t<button\n\t\t\t\t\ttype=\"button\"\n\t\t\t\t\tonclick={() => (notice = 'Password reset is unavailable in this preview.')}\n\t\t\t\t\tclass=\"text-muted-foreground hover:text-primary text-xs transition-colors\"\n\t\t\t\t>\n\t\t\t\t\tForgot it?\n\t\t\t\t</button>\n\t\t\t</div>\n\t\t\t<Input\n\t\t\t\tid=\"login-password\"\n\t\t\t\ttype=\"password\"\n\t\t\t\tautocomplete=\"current-password\"\n\t\t\t\trequired\n\t\t\t\tplaceholder=\"••••••••\"\n\t\t\t\tbind:value={password}\n\t\t\t/>\n\t\t</div>\n\t</div>\n\n\t<div class=\"flex w-full flex-col gap-2\">\n\t\t<Button type=\"submit\" class=\"w-full\">Sign in</Button>\n\t\t<Button\n\t\t\tvariant=\"outline\"\n\t\t\tclass=\"w-full\"\n\t\t\tonclick={() => (notice = 'GitHub sign-in is unavailable in this preview.')}\n\t\t>\n\t\t\t<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" class=\"size-4\" aria-hidden=\"true\"\n\t\t\t\t><path\n\t\t\t\t\td=\"M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.5 18 4.8 18 4.8c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z\"\n\t\t\t\t/></svg\n\t\t\t>\n\t\t\tContinue with GitHub\n\t\t</Button>\n\t</div>\n\n\t<p role=\"status\" class=\"text-muted-foreground text-xs\">\n\t\t{notice || 'Preview only. Your details stay in this browser.'}\n\t</p>\n</form>\n"
