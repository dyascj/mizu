{
	"name": "mizu",
	"version": "0.1.3",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=22 <25",
		"pnpm": ">=10.28.2 <11"
	},
	"pnpm": {
		"overrides": {
			"brace-expansion": "5.0.8",
			"postcss": "8.5.18",
			"tar": "7.5.22"
		}
	},
	"description": "A clean, airy design system for AI products. Chat, voice, reasoning, and streaming components for SvelteKit, Svelte 5, and Tailwind v4.",
	"keywords": [
		"svelte",
		"sveltekit",
		"tailwindcss",
		"design-system",
		"component-library",
		"ui",
		"shadcn-svelte",
		"bits-ui",
		"clean-ui",
		"ai-ui",
		"ai-components",
		"chat-ui",
		"voice-ui",
		"ai-design-system"
	],
	"homepage": "https://mizu-ui.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dyascj/mizu.git"
	},
	"bugs": {
		"url": "https://github.com/dyascj/mizu/issues"
	},
	"author": "CJ Dyas",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev --port 5183",
		"build": "vite build",
		"build:budget": "node scripts/check-bundle-budget.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "pnpm test:contracts && pnpm test:unit",
		"test:contracts": "node --test scripts/*.test.mjs",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:browser": "playwright test",
		"security:audit": "pnpm audit --audit-level high",
		"registry:build": "node scripts/build-registry.mjs",
		"registry:validate": "node scripts/validate-registry.mjs",
		"registry:consumer-check": "node scripts/verify-registry-consumer.mjs",
		"release:verify": "node scripts/release.mjs verify",
		"release:deployment-check": "node scripts/verify-deployed-registry.mjs",
		"repository:audit": "node scripts/github-repository.mjs audit",
		"repository:apply": "node scripts/github-repository.mjs apply",
		"new:component": "node scripts/new-component.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.1.1",
		"ajv": "^8.20.0",
		"eslint": "^10.7.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.26.0",
		"@tanstack/table-core": "^8.21.3",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"embla-carousel": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"paneforge": "^1.0.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"vaul-svelte": "1.0.0-next.7"
	}
}
